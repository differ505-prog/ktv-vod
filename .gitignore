# =====================================================
# Node.js / npm
# =====================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# =====================================================
# 環境變數 (敏感資料, 絕不 commit)
# =====================================================
.env
.env.local
.env.production
.env.development

# =====================================================
# Python (ktv-pipeline)
# =====================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-*.log
venv/
.venv/
env/
.python-version

# Demucs 模型快取 (數 GB, 請用環境變數指定至 volume)
.htdemucs/

# =====================================================
# KTV 處理結果與原始資料 (不進版控, 用 NAS volume 掛載)
# 但保留 .gitkeep 讓 git 追蹤空目錄
# =====================================================
# 不排除 ktv-data/ 整個目錄, 否則否定規則對其內檔案無效
# 改用 ktv-data/* 排除第一層, ktv-data/** 排除子目錄
ktv-data/*
ktv-data/**/*
videos/*
videos/**/*
ktv_output/
downloads/
tmp/
temp/

# 重新放行 .gitkeep
!/ktv-data/.gitkeep
!/videos/.gitkeep

# =====================================================
# OS / IDE
# =====================================================
.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*.swn
*~

# =====================================================
# Docker / Logs
# =====================================================
*.log
docker-compose.override.yml

# =====================================================
# Build / Coverage
# =====================================================
dist/
build/
coverage/
.nyc_output/
