# syntax=docker/dockerfile:1.6

# =========================================================
# KTV VOD System - Node.js 中控 (The Brain)
# 多階段建置, 最終映像只含 runtime
# =========================================================

# --- builder ---
FROM node:20-bookworm-slim AS builder
WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund

# --- runtime ---
FROM node:20-bookworm-slim AS runtime
WORKDIR /app

# 唯讀系統帳號 (強化安全)
RUN groupadd --system --gid 1001 ktv \
  && useradd --system --uid 1001 --gid ktv --no-create-home --shell /usr/sbin/nologin ktv

# 系統工具: ffmpeg + icafelabs (用於額外的影片處理)
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ffmpeg \
       ca-certificates \
       tini \
  && rm -rf /var/lib/apt/lists/*

# 從 builder 拷貝 node_modules
COPY --from=builder --chown=ktv:ktv /app/node_modules ./node_modules

# 應用程式碼
COPY --chown=ktv:ktv package.json ./
COPY --chown=ktv:ktv server.js ./
COPY --chown=ktv:ktv public ./public
# 輔助腳本（音訊抽軌等）
COPY --chown=ktv:ktv scripts ./scripts

# 預留資料目錄 (實際建議 bind mount NAS volume)
RUN mkdir -p /app/videos /app/ktv-data/processed /app/ktv-data/work \
  && chown -R ktv:ktv /app/videos /app/ktv-data

ENV NODE_ENV=production \
    PORT=3000 \
    VIDEO_DIR=/app/videos \
    VIDEO_URL_PREFIX=/videos

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:' + (process.env.PORT||3000) + '/api/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

USER ktv

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "server.js"]
