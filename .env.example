# =====================================================
# KTV VOD System - 環境變數範本
# =====================================================
# 複製這份檔案： cp .env.example .env
# 然後填入實際的值（不要 commit .env）

# ===== Node.js 伺服器 =====

# 監聽 Port (預設 3000)
PORT=3000

# 允許存取來源 (CORS), 多個用逗號分隔
# '*' 代表完全開放 (區網用沒問題)
CORS_ORIGIN=*

# Node 環境
NODE_ENV=production

# ===== 影片存放路徑 =====
# 預設 ./videos (Docker 部署時改為 /ktv-data/videos)
VIDEO_DIR=./videos

# 公開 URL prefix (供前端 <video> 使用)
# 例如 http://192.168.1.100:3000/videos/song_ktv.mp4
VIDEO_URL_PREFIX=/videos

# ===== Python Pipeline =====

# Pipeline 工作根目錄 (暫存檔會在這底下)
PIPELINE_WORK_DIR=/tmp/ktv-pipeline

# 輸出目錄 (處理完成的 _ktv.mp4 放這裡)
PIPELINE_OUTPUT_DIR=./ktv_output

# Demucs 模型 (預設 htdemucs, 可改 htdemucs_ft 精度更高但更慢)
DEMUCS_MODEL=htdemucs

# 強制使用 CPU (沒 GPU 的 NAS 設 true)
DEMUCS_FORCE_CPU=false

# Pipeline API 認證 token (Node 端呼叫時要帶)
PIPELINE_API_TOKEN=change-me-to-a-random-secret-string

# ===== NAS / 部署相關 =====

# 對外顯示的 IP (QR code 會用這個)
# 留空會自動偵測本機 LAN IP
PUBLIC_HOST=

# 日誌層級 (debug | info | warn | error)
LOG_LEVEL=info
